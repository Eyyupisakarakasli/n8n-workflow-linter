{
  "name": "Clean - Canonical HubSpot Dedupe",
  "nodes": [
    {
      "id": "webhook-dedupe",
      "name": "Receive Partner Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "path": "partner-lead",
        "httpMethod": "POST",
        "authentication": "headerAuth",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "validate-dedupe",
      "name": "Validate Lead Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "email-not-empty",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "normalize-dedupe",
      "name": "Normalize Lead Email And Phone",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [480, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "email",
              "value": "={{ $json.email.trim().toLowerCase() }}"
            },
            {
              "name": "phone",
              "value": "={{ String($json.phone || '').replace(/[^0-9+]/g, '') }}"
            }
          ]
        }
      }
    },
    {
      "id": "search-hubspot",
      "name": "Search HubSpot Contact By Email",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [720, 0],
      "parameters": {
        "resource": "contact",
        "operation": "search",
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "email",
                    "operator": "EQ",
                    "value": "={{ $json.email }}"
                  }
                ]
              }
            }
          ]
        }
      },
      "credentials": {
        "hubspotApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "if-existing-contact",
      "name": "Contact Already Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 0],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $items().length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      }
    },
    {
      "id": "update-contact",
      "name": "Update Existing HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [1200, -100],
      "parameters": {
        "resource": "contact",
        "operation": "update",
        "contactId": "={{ $json.id }}",
        "additionalFields": {
          "phone": "={{ $json.phone }}"
        }
      },
      "credentials": {
        "hubspotApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "upsert-contact-dedupe",
      "name": "Create or Update HubSpot Contact When Missing",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [1560, 120],
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "phone": "={{ $json.phone }}"
        }
      },
      "credentials": {
        "hubspotApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "restore-missing-contact-email",
      "name": "Restore Missing Contact Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1080, 120],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "email",
              "value": "={{ $('Normalize Lead Email And Phone').item.json.email }}"
            }
          ]
        },
        "includeOtherFields": true
      }
    },
    {
      "id": "validate-missing-contact-email",
      "name": "Validate Missing Contact Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 120],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "missing-contact-email-not-empty",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    }
  ],
  "connections": {
    "Receive Partner Lead": {
      "main": [
        [
          {
            "node": "Validate Lead Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Lead Email": {
      "main": [
        [
          {
            "node": "Normalize Lead Email And Phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Lead Email And Phone": {
      "main": [
        [
          {
            "node": "Search HubSpot Contact By Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search HubSpot Contact By Email": {
      "main": [
        [
          {
            "node": "Contact Already Exists",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Contact Already Exists": {
      "main": [
        [
          {
            "node": "Update Existing HubSpot Contact",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Restore Missing Contact Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Restore Missing Contact Email": {
      "main": [
        [
          {
            "node": "Validate Missing Contact Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Missing Contact Email": {
      "main": [
        [
          {
            "node": "Create or Update HubSpot Contact When Missing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "REPLACE_WITH_ERROR_WORKFLOW_ID"
  }
}
