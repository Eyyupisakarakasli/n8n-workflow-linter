{
  "name": "Risky - Same Branch Duplicate Writes",
  "nodes": [
    {
      "id": "webhook-duplicate",
      "name": "Receive Lead For Duplicate Write",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "path": "duplicate-lead",
        "httpMethod": "POST",
        "authentication": "headerAuth"
      }
    },
    {
      "id": "validate-duplicate",
      "name": "Validate Duplicate Write Lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "email-not-empty",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "create-first",
      "name": "Create First HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [480, 0],
      "parameters": {
        "resource": "contact",
        "operation": "create",
        "email": "={{ $json.email }}"
      },
      "credentials": {
        "hubspotApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      }
    },
    {
      "id": "create-second",
      "name": "Create Second HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [720, 0],
      "parameters": {
        "resource": "contact",
        "operation": "create",
        "email": "={{ $json.email }}"
      },
      "credentials": {
        "hubspotApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      }
    }
  ],
  "connections": {
    "Receive Lead For Duplicate Write": {
      "main": [
        [
          {
            "node": "Validate Duplicate Write Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Duplicate Write Lead": {
      "main": [
        [
          {
            "node": "Create First HubSpot Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create First HubSpot Contact": {
      "main": [
        [
          {
            "node": "Create Second HubSpot Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
