{
  "name": "Risky - Webhook To SQL Without Validation",
  "nodes": [
    {
      "id": "wh",
      "name": "Receive Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "event",
        "httpMethod": "POST",
        "authentication": "headerAuth",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "pg",
      "name": "Lookup Customer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM customers WHERE email = '{{ $json.email }}'"
      }
    }
  ],
  "connections": {
    "Receive Event": {
      "main": [
        [
          {
            "node": "Lookup Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "error-handler"
  }
}
