{
  "name": "Demo - Risky Webhook to HubSpot",
  "nodes": [
    {
      "id": "webhook-1",
      "name": "Test Webhook Lead Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "path": "test-lead-intake",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "hubspot-1",
      "name": "Create HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "parameters": {
        "resource": "contact",
        "operation": "create",
        "email": "={{$json.email}}",
        "additionalFields": {
          "phone": "={{$json.phone}}",
          "firstname": "={{$json.first_name}}"
        }
      }
    }
  ],
  "connections": {
    "Test Webhook Lead Intake": {
      "main": [
        [
          {
            "node": "Create HubSpot Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
