{
  "name": "Demo - API Polling Without Error Handling",
  "nodes": [
    {
      "id": "schedule-1",
      "name": "Every Minute Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "value": 1
            }
          ]
        }
      }
    },
    {
      "id": "http-1",
      "name": "Fetch Orders List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "parameters": {
        "method": "GET",
        "url": "https://api.example.com/orders?api_key=hardcoded_demo_token_123456789",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "slack-1",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "parameters": {
        "operation": "post",
        "channel": "#ops",
        "text": "={{$json.order_id}}"
      }
    }
  ],
  "connections": {
    "Every Minute Schedule": {
      "main": [
        [
          {
            "node": "Fetch Orders List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Orders List": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
